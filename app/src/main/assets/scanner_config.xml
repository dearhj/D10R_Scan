<?xml version="1.0" encoding="utf-8"?>
<deviceCofing>
    <device>
        <property name="model" value="D10R"/>

        <!-- 0 表示默认不选择
        public static final int HR22+ = 1;
        public static final int EM3100 = 2;
        public static final int ME11 = 3;
        public static final int M1 = 4;-->
        <property name="ScanModule" value="0"/>

        <!--扫描开机自启-->
        <property name="openService_reboot" value = "true"/>
        <!--声音开关-->
        <property name="scanVoice" value = "true"/>
        <!--hid模式，一定要和控件模式互斥-->
        <property name="HIDChoose" value = "true"/>
        <!--新增控件输入模式-->
        <property name="WidgetChoose" value = "false"/>
        <!--扫描模式
            SCNMOD0 电平触发
            SCNMOD2 感应模式  由于D10R没有物理按键，所以只能设置为感应模式去扫码
            SCNMOD3 连续扫描
            SCNMOD4 脉冲模式  ME11和M1模块没有脉冲模式
            -->
        <property name="ScanModel" value = "SCNMOD2"/>
        <!--剪切板功能的选择-->
        <property name="ClipBoardChoose" value = "false"/>

    </device>
    <buttons>
        <button id="F key">
            <closeBroadcast>com.android.action.keyevent.KEYCODE_KEYCODE_SCAN_F_UP</closeBroadcast>
            <openBroadcast>com.android.action.keyevent.KEYCODE_KEYCODE_SCAN_F_DOWN</openBroadcast>
            <value>true</value>
        </button>
    </buttons>
</deviceCofing>

